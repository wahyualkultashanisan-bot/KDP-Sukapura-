<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dashboard — KDP Sukapura</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
*{box-sizing:border-box}

body{
  margin:0;
  background:#f3f6fb;
  font-family:Arial,sans-serif;
  color:#172b55
}

header{
  background:#1557b0;
  color:white;
  padding:16px 20px;
  position:sticky;
  top:0;
  z-index:10
}

.header-inner{
  max-width:1100px;
  margin:auto;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px
}

.logo-title{
  font-size:20px;
  font-weight:800
}

.user{
  font-size:13px;
  opacity:.9
}

.logout{
  background:white;
  color:#1557b0;
  border:0;
  padding:9px 13px;
  border-radius:9px;
  font-weight:700;
  cursor:pointer
}

main{
  max-width:1100px;
  margin:auto;
  padding:20px
}

.welcome{
  margin-bottom:20px
}

.welcome h1{
  margin:0 0 6px
}

.welcome p{
  margin:0;
  color:#6b7894
}

.stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
  margin-bottom:20px
}

.stat{
  background:white;
  border-radius:18px;
  padding:20px;
  box-shadow:0 10px 30px #142b5512
}

.stat-title{
  color:#6b7894;
  font-size:14px
}

.stat-value{
  font-size:30px;
  font-weight:800;
  margin-top:7px
}

.card{
  background:white;
  border-radius:18px;
  padding:20px;
  box-shadow:0 10px 30px #142b5512;
  margin-bottom:20px
}

.card h2{
  margin-top:0
}

.form-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px
}

input,select,textarea{
  width:100%;
  padding:12px;
  border:1px solid #d7deea;
  border-radius:9px;
  font-family:inherit
}

textarea{
  min-height:90px;
  resize:vertical
}

.full{
  grid-column:1/-1
}

.add-btn{
  margin-top:12px;
  padding:12px 18px;
  border:0;
  border-radius:9px;
  background:#1557b0;
  color:white;
  font-weight:700;
  cursor:pointer
}

.table-wrap{
  overflow-x:auto
}

table{
  width:100%;
  border-collapse:collapse
}

th,td{
  padding:13px 10px;
  text-align:left;
  border-bottom:1px solid #edf0f5;
  white-space:nowrap
}

th{
  font-size:13px;
  color:#6b7894
}

.badge{
  display:inline-block;
  padding:5px 9px;
  border-radius:20px;
  background:#eaf2ff;
  color:#1557b0;
  font-size:12px;
  font-weight:700
}

.delete-btn{
  border:0;
  background:#fff0f0;
  color:#b42318;
  padding:7px 10px;
  border-radius:7px;
  cursor:pointer;
  font-weight:700
}

.message{
  display:none;
  padding:12px;
  margin-bottom:15px;
  border-radius:10px
}

.error{
  display:block;
  background:#fff0f0;
  color:#b42318
}

.success{
  display:block;
  background:#ecfdf3;
  color:#027a48
}

.empty{
  text-align:center;
  padding:25px;
  color:#6b7894
}

@media(max-width:700px){
  .stats{
    grid-template-columns:1fr
  }

  .form-grid{
    grid-template-columns:1fr
  }

  .header-inner{
    flex-wrap:wrap
  }
}
</style>
</head>

<body>

<header>

  <div class="header-inner">

    <div>
      <div class="logo-title">
        KDP Sukapura
      </div>

      <div class="user" id="userEmail">
        Memuat...
      </div>
    </div>

    <button class="logout" id="logoutButton">
      Logout
    </button>

  </div>

</header>

<main>

  <section class="welcome">
    <h1>Dashboard Admin</h1>
    <p>
      Kelola data KDP Sukapura melalui dashboard ini.
    </p>
  </section>

  <div id="message" class="message"></div>

  <section class="stats">

    <div class="stat">
      <div class="stat-title">
        Total Data
      </div>

      <div class="stat-value" id="totalData">
        0
      </div>
    </div>

    <div class="stat">
      <div class="stat-title">
        Data Aktif
      </div>

      <div class="stat-value" id="activeData">
        0
      </div>
    </div>

    <div class="stat">
      <div class="stat-title">
        Data Nonaktif
      </div>

      <div class="stat-value" id="inactiveData">
        0
      </div>
    </div>

  </section>

  <section class="card">

    <h2>Tambah Data</h2>

    <form id="dataForm">

      <div class="form-grid">

        <div>
          <input
            id="nama"
            type="text"
            placeholder="Nama"
            required
          >
        </div>

        <div>
          <input
            id="kategori"
            type="text"
            placeholder="Kategori"
          >
        </div>

        <div>
          <select id="status">

            <option value="Aktif">
              Aktif
            </option>

            <option value="Nonaktif">
              Nonaktif
            </option>

          </select>
        </div>

        <div class="full">
          <textarea
            id="keterangan"
            placeholder="Keterangan"
          ></textarea>
        </div>

      </div>

      <button
        class="add-btn"
        type="submit"
        id="addButton"
      >
        + Tambah Data
      </button>

    </form>

  </section>

  <section class="card">

    <h2>Data KDP</h2>

    <div class="table-wrap">

      <table>

        <thead>
          <tr>
            <th>Nama</th>
            <th>Kategori</th>
            <th>Status</th>
            <th>Keterangan</th>
            <th>Aksi</th>
          </tr>
        </thead>

        <tbody id="dataBody">

          <tr>
            <td colspan="5" class="empty">
              Memuat data...
            </td>
          </tr>

        </tbody>

      </table>

    </div>

  </section>

</main>

<script>
const SUPABASE_URL =
  "https://mdqexxvglyyaluhfzslx.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_c4Lh2xS1CBoeC4qKCyfctQ_FRWTZvVX";

const supabaseClient = window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_KEY
);

const userEmail =
  document.getElementById("userEmail");

const dataBody =
  document.getElementById("dataBody");

const totalData =
  document.getElementById("totalData");

const activeData =
  document.getElementById("activeData");

const inactiveData =
  document.getElementById("inactiveData");

const message =
  document.getElementById("message");

function showMessage(text,type){
  message.textContent = text;
  message.className = "message " + type;

  setTimeout(() => {
    message.className = "message";
  },4000);
}

async function checkLogin(){

  const {
    data: {
      session
    }
  } = await supabaseClient.auth.getSession();

  if(!session){
    window.location.href = "/login.html";
    return null;
  }

  userEmail.textContent =
    session.user.email || "";

  return session;
}

async function loadData(){

  const {
    data,
    error
  } = await supabaseClient
    .from("kdp_data")
    .select("*")
    .order("created_at",{ascending:false});

  if(error){

    showMessage(
      "Gagal mengambil data: " +
      error.message,
      "error"
    );

    return;
  }

  totalData.textContent =
    data.length;

  activeData.textContent =
    data.filter(
      item => item.status === "Aktif"
    ).length;

  inactiveData.textContent =
    data.filter(
      item => item.status === "Nonaktif"
    ).length;

  if(data.length === 0){

    dataBody.innerHTML = `
      <tr>
        <td colspan="5" class="empty">
          Belum ada data.
        </td>
      </tr>
    `;

    return;
  }

  dataBody.innerHTML =
    data.map(item => `

      <tr>

        <td>
          <strong>
            ${escapeHtml(item.nama)}
          </strong>
        </td>

        <td>
          ${escapeHtml(item.kategori || "-")}
        </td>

        <td>
          <span class="badge">
            ${escapeHtml(item.status || "-")}
          </span>
        </td>

        <td>
          ${escapeHtml(item.keterangan || "-")}
        </td>

        <td>

          <button
            class="delete-btn"
            onclick="deleteData(${item.id})"
          >
            Hapus
          </button>

        </td>

      </tr>

    `).join("");
}

function escapeHtml(value){

  return String(value)
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}

document
  .getElementById("dataForm")
  .addEventListener("submit",async function(e){

    e.preventDefault();

    const button =
      document.getElementById("addButton");

    button.disabled = true;
    button.textContent = "Menyimpan...";

    const nama =
      document.getElementById("nama")
      .value.trim();

    const kategori =
      document.getElementById("kategori")
      .value.trim();

    const status =
      document.getElementById("status")
      .value;

    const keterangan =
      document.getElementById("keterangan")
      .value.trim();

    const {
      error
    } = await supabaseClient
      .from("kdp_data")
      .insert({
        nama,
        kategori,
        status,
        keterangan
      });

    if(error){

      showMessage(
        "Gagal menyimpan: " +
        error.message,
        "error"
      );

    }else{

      showMessage(
        "Data berhasil ditambahkan.",
        "success"
      );

      this.reset();

      await loadData();
    }

    button.disabled = false;
    button.textContent = "+ Tambah Data";
  });

async function deleteData(id){

  const yakin =
    confirm(
      "Apakah kamu yakin ingin menghapus data ini?"
    );

  if(!yakin) return;

  const {
    error
  } = await supabaseClient
    .from("kdp_data")
    .delete()
    .eq("id",id);

  if(error){

    showMessage(
      "Gagal menghapus: " +
      error.message,
      "error"
    );

    return;
  }

  showMessage(
    "Data berhasil dihapus.",
    "success"
  );

  await loadData();
}

document
  .getElementById("logoutButton")
  .addEventListener("click",async function(){

    await supabaseClient.auth.signOut();

    window.location.href =
      "/login.html";
  });

(async function(){

  const session =
    await checkLogin();

  if(session){
    await loadData();
  }

})();
</script>

</body>
</html>
